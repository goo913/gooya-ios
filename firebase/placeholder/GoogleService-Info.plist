-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>Agooya-placeholder-key-000000000000000</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.hybertec.gooya</string>
	<key>PROJECT_ID</key>
	<string>gooya-37d79</string>
	<key>STORAGE_BUCKET</key>
	<string>gooya-37d79.firebasestorage.app</string>
	<key>DATABASE_URL</key>
	<string>https://gooya-37d79.firebaseio.com</string>
	<key>IS_ADS_ENABLED</key>
	<false></false>
	<key>IS_ANALYTICS_ENABLED</key>
	<false></false>
	<key>IS_APPINVITE_ENABLED</key>
	<true></true>
	<key>IS_GCM_ENABLED</key>
	<true></true>
	<key>IS_SIGNIN_ENABLED</key>
	<true></true>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
